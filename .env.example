# Copy this file to .env and fill in the values.

# Discord channel webhook (Channel settings -> Integrations -> Webhooks -> New Webhook -> Copy URL)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXX/XXXXXXXX

# ID of the F1 role to ping (Developer Mode on -> Server settings -> Roles -> right-click F1 -> Copy Role ID)
F1_ROLE_ID=123456789012345678

# Minutes before each session to notify. 0 = "starting now".
REMINDER_MINUTES=60,15,5,0

# Which sessions to notify about. Options: fp1,fp2,fp3,sprint_qualifying,sprint,qualifying,race
SESSIONS=sprint_qualifying,sprint,qualifying,race

# All displayed times use this timezone (handles EET/EEST summer time automatically).
TIMEZONE=Europe/Tallinn

# --- Optional: Discord bot for the /f1test and /f1next slash commands ---
# Leave empty to run webhook-only (you can still test with: f1notify test)
DISCORD_BOT_TOKEN=
# Your server ID - makes slash commands appear instantly instead of after up to 1 hour
DISCORD_GUILD_ID=
